{
  "name": "@kolezka/fleet-control-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness panel for Fleet Control: a conversation view tab and a right sidebar tab",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "proxy.js",
    "client.js"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
