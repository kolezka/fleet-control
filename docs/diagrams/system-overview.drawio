<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" modified="2026-11-10T00:00:00.000Z" agent="Claude Code" version="24.7.17" type="device"><diagram id="arch" name="1 Architecture"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Fleet Control: system architecture (as implemented on main, 2026-11-10)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1000" height="30" as="geometry"/></mxCell><mxCell id="g_mac" value="MacBook (client, holds no execution)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7a7a7a;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="330" height="800" as="geometry"/></mxCell><mxCell id="g_host" value="Workstation: Fleet Control host service (one per host, auth on every route)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7a7a7a;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="640" height="800" as="geometry"/></mxCell><mxCell id="g_tmux" value="Workstation: tmux and sessions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7a7a7a;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1050" y="60" width="330" height="800" as="geometry"/></mxCell><mxCell id="g_peer" value="Peer workstation (independent, not reached directly)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7a7a7a;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="380" y="890" width="640" height="110" as="geometry"/></mxCell><mxCell id="OP" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;approves requests, sends instructions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="290" height="60" as="geometry"/></mxCell><mxCell id="BR" value="&lt;b&gt;Terminal Deck (browser)&lt;/b&gt;&lt;br&gt;web/index.html, web/app.ts&lt;br&gt;ghostty-web panes, read-only&lt;br&gt;polls requests and commands every 3 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="210" width="290" height="100" as="geometry"/></mxCell><mxCell id="GW" value="&lt;b&gt;Client gateway&lt;/b&gt;&lt;br&gt;client.ts, 127.0.0.1 only&lt;br&gt;holds per-host tokens, never in the browser&lt;br&gt;allowlisted API and read-only streams, verified TLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="350" width="290" height="110" as="geometry"/></mxCell><mxCell id="ASST" value="&lt;b&gt;Local assistant (Claude Code)&lt;/b&gt;&lt;br&gt;MCP server fleet-control-mini&lt;br&gt;relays real human answers only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="500" width="290" height="90" as="geometry"/></mxCell><mxCell id="API" value="&lt;b&gt;HTTP API /api/*&lt;/b&gt;&lt;br&gt;sessions, screen, commands, requests,&lt;br&gt;hosts, whoami, login, terminal socket&lt;br&gt;same-origin checks on writes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="300" height="100" as="geometry"/></mxCell><mxCell id="MCP" value="&lt;b&gt;MCP at /mcp&lt;/b&gt;&lt;br&gt;Streamable HTTP, stateless&lt;br&gt;command_* tools use the same queue&lt;br&gt;principal comes from the token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="300" height="100" as="geometry"/></mxCell><mxCell id="CMD" value="&lt;b&gt;Command queue&lt;/b&gt;&lt;br&gt;src/commands.ts&lt;br&gt;states, events, idempotency keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="250" width="300" height="100" as="geometry"/></mxCell><mxCell id="REQ" value="&lt;b&gt;Requests and gate&lt;/b&gt;&lt;br&gt;src/requests.ts&lt;br&gt;runs, phase revision, approvals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="720" y="250" width="300" height="100" as="geometry"/></mxCell><mxCell id="DEL" value="&lt;b&gt;Delivery&lt;/b&gt;&lt;br&gt;src/delivery.ts, one at a time&lt;br&gt;crash or unclear exit = delivery_unknown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="390" width="300" height="90" as="geometry"/></mxCell><mxCell id="OBS" value="&lt;b&gt;Model observer&lt;/b&gt;&lt;br&gt;src/observe/claude.ts&lt;br&gt;pane pid, then session file, then transcript" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="720" y="390" width="300" height="90" as="geometry"/></mxCell><mxCell id="FCLI" value="&lt;b&gt;agent-fleet adapter&lt;/b&gt;&lt;br&gt;src/fleet/cli.ts&lt;br&gt;calls only the fleet CLI binary, typed errors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="520" width="300" height="90" as="geometry"/></mxCell><mxCell id="DB" value="&lt;b&gt;SQLite (bun:sqlite)&lt;/b&gt;&lt;br&gt;FLEET_CONTROL_DB, in memory if unset&lt;br&gt;sessions, model_observations, commands,&lt;br&gt;command_events, runs, requests, request_events" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="520" width="300" height="120" as="geometry"/></mxCell><mxCell id="TERM" value="&lt;b&gt;Terminal WebSocket&lt;/b&gt;&lt;br&gt;/api/sessions/:name/terminal&lt;br&gt;viewer runs fleet attach --read-only&lt;br&gt;any client input closes it (1008)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="720" y="660" width="300" height="90" as="geometry"/></mxCell><mxCell id="SUP" value="&lt;b&gt;Supervisor or orchestrator&lt;/b&gt;&lt;br&gt;Claude Code session in tmux&lt;br&gt;reads and answers commands via /mcp&lt;br&gt;reports phase, requests and gates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1070" y="110" width="290" height="100" as="geometry"/></mxCell><mxCell id="WORK" value="&lt;b&gt;Worker and reviewer&lt;/b&gt;&lt;br&gt;agent work inside phased runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1070" y="230" width="290" height="70" as="geometry"/></mxCell><mxCell id="SHELL" value="&lt;b&gt;Shell sessions&lt;/b&gt;&lt;br&gt;no model; watchdog and fixtures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1070" y="320" width="290" height="60" as="geometry"/></mxCell><mxCell id="TMUXP" value="&lt;b&gt;tmux fleet socket&lt;/b&gt;&lt;br&gt;one pane per session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1070" y="400" width="290" height="70" as="geometry"/></mxCell><mxCell id="FLEETCLI" value="&lt;b&gt;agent-fleet CLI&lt;/b&gt;&lt;br&gt;vendor/agent-fleet, pinned submodule&lt;br&gt;screen, status, send, attach --read-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1070" y="500" width="290" height="90" as="geometry"/></mxCell><mxCell id="TR" value="&lt;b&gt;Claude Code files on disk&lt;/b&gt;&lt;br&gt;~/.claude/sessions/&amp;lt;pid&amp;gt;.json&lt;br&gt;~/.claude/projects/.../&amp;lt;session&amp;gt;.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1070" y="620" width="290" height="90" as="geometry"/></mxCell><mxCell id="PEER" value="&lt;b&gt;Peer Fleet Control service&lt;/b&gt;&lt;br&gt;own tokens, own SQLite, own tmux; no shared scheduler or approval queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="925" width="600" height="60" as="geometry"/></mxCell><mxCell id="e1" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="OP" target="BR"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="HTTP and WebSocket, loopback only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="BR" target="GW"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GW" target="API"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="358" y="405"/><mxPoint x="358" y="160"/></Array></mxGeometry></mxCell><mxCell id="e4" value="HTTPS to peer, its own token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="GW" target="PEER"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="358" y="440"/><mxPoint x="358" y="955"/></Array></mxGeometry></mxCell><mxCell id="e5" value="MCP over HTTPS, bearer token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ASST" target="MCP"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="372" y="545"/><mxPoint x="372" y="46"/><mxPoint x="870" y="46"/></Array></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="SUP" target="MCP"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="REST: submit, list, get" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="API" target="CMD"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="MCP: run, phase, request tools" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="MCP" target="REQ"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="deliver queued command" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="CMD" target="DEL"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="fleet send" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="DEL" target="FCLI"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="fleet screen, status, send, attach" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FCLI" target="FLEETCLI"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="610"/><mxPoint x="550" y="775"/><mxPoint x="1045" y="775"/><mxPoint x="1045" y="545"/></Array></mxGeometry></mxCell><mxCell id="e12" value="tmux panes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FLEETCLI" target="TMUXP"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="Status: the .4 service serves a test fleet only. Terminal is read-only. An agent-fleet send-keys bug blocks the viewer for real agents (docs/bugs). Dashed frames are machine or trust boundaries. Model labels are observed only from Claude Code transcripts." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="1010" width="1340" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cmd" name="2 Command lifecycle"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Command lifecycle (src/commands.ts, src/delivery.ts)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1000" height="30" as="geometry"/></mxCell><mxCell id="SUBMIT" value="&lt;b&gt;Submit&lt;/b&gt;&lt;br&gt;command_submit (MCP) or POST /api/commands&lt;br&gt;same key and same intent = same record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="300" height="70" as="geometry"/></mxCell><mxCell id="QUEUED" value="&lt;b&gt;queued&lt;/b&gt;&lt;br&gt;stored, not yet pasted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="190" width="300" height="60" as="geometry"/></mxCell><mxCell id="DELIVERING" value="&lt;b&gt;delivering&lt;/b&gt;&lt;br&gt;fleet send in progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="300" width="300" height="60" as="geometry"/></mxCell><mxCell id="DELIVERED" value="&lt;b&gt;delivered&lt;/b&gt;&lt;br&gt;first line seen in the pane&lt;br&gt;not approval, not acknowledged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="410" width="300" height="70" as="geometry"/></mxCell><mxCell id="ACCEPTED" value="&lt;b&gt;accepted&lt;/b&gt;&lt;br&gt;supervisor accepts (command_respond)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="530" width="300" height="60" as="geometry"/></mxCell><mxCell id="RUNNING" value="&lt;b&gt;running&lt;/b&gt;&lt;br&gt;command_report: running" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="640" width="300" height="60" as="geometry"/></mxCell><mxCell id="COMPLETED" value="&lt;b&gt;completed&lt;/b&gt;&lt;br&gt;command_report: completed, with evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="750" width="300" height="70" as="geometry"/></mxCell><mxCell id="REFUSED" value="&lt;b&gt;refused before paste&lt;/b&gt;&lt;br&gt;not sent, or no session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="240" height="60" as="geometry"/></mxCell><mxCell id="UNKNOWN" value="&lt;b&gt;delivery_unknown&lt;/b&gt;&lt;br&gt;any other outcome, crash, or restart&lt;br&gt;never retried automatically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="290" width="280" height="80" as="geometry"/></mxCell><mxCell id="REJECTED" value="&lt;b&gt;rejected&lt;/b&gt;&lt;br&gt;terminal, with reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="470" width="280" height="60" as="geometry"/></mxCell><mxCell id="FAILED" value="&lt;b&gt;failed&lt;/b&gt;&lt;br&gt;command_report: failed, with evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="640" width="280" height="60" as="geometry"/></mxCell><mxCell id="c1" value="submitted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="SUBMIT" target="QUEUED"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c2" value="command_deliver or retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="QUEUED" target="DELIVERING"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c3" value="fleet send exits 0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="DELIVERING" target="DELIVERED"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="DELIVERING" target="REFUSED"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c5" value="safe to retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="REFUSED" target="QUEUED"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="220"/></Array></mxGeometry></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="DELIVERING" target="UNKNOWN"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="command_respond: accept" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="DELIVERED" target="ACCEPTED"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="supervisor accepts or rejects" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="UNKNOWN" target="REJECTED"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="command_report: running" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ACCEPTED" target="RUNNING"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="command_report: completed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="RUNNING" target="COMPLETED"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="RUNNING" target="FAILED"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="NOTES" value="Rules: delivered does not mean approved. Completion is refused before acceptance. Delivery outcomes come only from the service. Every change appends a row to command_events with actor and detail. Also allowed: queued to accepted or rejected, accepted to completed or failed, delivery_unknown to accepted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1"><mxGeometry x="340" y="850" width="640" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="gate" name="3 Approval gate"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Approval gate (src/requests.ts, MCP request_* tools, REST resolve)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1000" height="30" as="geometry"/></mxCell><mxCell id="RUN" value="&lt;b&gt;run_register&lt;/b&gt;&lt;br&gt;one run, one orchestrator, revision 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="300" height="70" as="geometry"/></mxCell><mxCell id="PHASE" value="&lt;b&gt;phase_update&lt;/b&gt;&lt;br&gt;expectedRevision must match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="190" width="300" height="70" as="geometry"/></mxCell><mxCell id="CREATE" value="&lt;b&gt;request_create&lt;/b&gt;&lt;br&gt;bound to run, phase and revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="300" width="300" height="70" as="geometry"/></mxCell><mxCell id="OPEN" value="&lt;b&gt;open&lt;/b&gt;&lt;br&gt;approval requested, no answer yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="410" width="300" height="60" as="geometry"/></mxCell><mxCell id="SRC" value="&lt;b&gt;Answer sources&lt;/b&gt;&lt;br&gt;Terminal Deck: POST resolve, actor from token&lt;br&gt;local assistant: request_resolve, real answers only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="400" width="300" height="80" as="geometry"/></mxCell><mxCell id="RESOLVED" value="&lt;b&gt;resolved&lt;/b&gt;&lt;br&gt;one response, tied to the revision&lt;br&gt;a second different answer is a conflict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="530" width="300" height="80" as="geometry"/></mxCell><mxCell id="DEC" value="approve or decline?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="370" y="650" width="240" height="90" as="geometry"/></mxCell><mxCell id="DECLINED" value="&lt;b&gt;declined&lt;/b&gt;&lt;br&gt;gate stays closed; decline wins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="240" height="70" as="geometry"/></mxCell><mxCell id="ACK" value="&lt;b&gt;request_acknowledge&lt;/b&gt;&lt;br&gt;orchestrator confirms it read the answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="790" width="300" height="60" as="geometry"/></mxCell><mxCell id="GATE" value="&lt;b&gt;request_gate(run, phase, revision)&lt;/b&gt;&lt;br&gt;true only for approve on this exact revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="900" width="300" height="70" as="geometry"/></mxCell><mxCell id="NEXT" value="&lt;b&gt;phase_update to next phase&lt;/b&gt;&lt;br&gt;a separate step, not implied by approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="1020" width="300" height="60" as="geometry"/></mxCell><mxCell id="STALE" value="&lt;b&gt;stale&lt;/b&gt;&lt;br&gt;new revision or phase: open requests can no longer be answered or gated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="190" width="300" height="70" as="geometry"/></mxCell><mxCell id="NOTES" value="&lt;b&gt;Rules in code (src/requests.ts)&lt;/b&gt;&lt;br&gt;- Approval covers one run, phase and revision.&lt;br&gt;- Decline wins over an approval.&lt;br&gt;- Acknowledged is not phase start.&lt;br&gt;- Only the named orchestrator writes the phase record.&lt;br&gt;&lt;br&gt;Status: checked on the .4 test fleet with scripts and a browser. No real phased-delivery orchestrator has used these tools yet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1"><mxGeometry x="700" y="560" width="300" height="260" as="geometry"/></mxCell><mxCell id="r1" value="then phase_update per step" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="RUN" target="PHASE"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="request_create at this revision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PHASE" target="CREATE"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="CREATE" target="OPEN"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="answer recorded" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="OPEN" target="RESOLVED"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r5" value="human answer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="SRC" target="RESOLVED"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="440"/><mxPoint x="670" y="570"/></Array></mxGeometry></mxCell><mxCell id="r6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="RESOLVED" target="DEC"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r7" value="decline" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="DEC" target="DECLINED"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r8" value="approve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="DEC" target="ACK"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r9" value="orchestrator reads answer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ACK" target="GATE"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r10" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GATE" target="NEXT"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="PHASE" target="STALE"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
